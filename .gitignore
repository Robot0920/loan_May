# --- data — never commit raw or processed data ---
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
!data/README.md

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_meta

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db

# --- Model artifacts (track via MLflow / DVC, not git) ---
models/
*.pkl
*.joblib
*.onnx
mlruns/

# --- Secrets ---
.env
.env.local
*.key
kaggle.json

# --- Test / coverage ---
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# --- Logs ---
*.log
logs/
